// ToiletGo KH — Prisma schema (Prisma ORM 7, PostgreSQL / Supabase)
//
// Conventions
// - UUID primary keys generated by Prisma.
// - Nullable booleans mean "unknown" (unknown accessibility is NOT the same as inaccessible).
// - Prices are nonnegative integers in Cambodian riel (KHR).
// - Opening hours are stored as minutes from local midnight (Asia/Phnom_Penh).
//   closeMinute may exceed 1440 to represent overnight intervals (e.g. 18:00–02:00 = 1080–1560).
// - CHECK constraints (ratings, prices, coordinates, minutes) live in the SQL migration because
//   Prisma schema does not model them. Prisma Migrate does not drop unmanaged CHECK constraints.
// - Storage objects are referenced by bucket + objectPath, never by expiring signed URLs.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  // Extensionless relative imports so the generated client compiles to CommonJS with tsc, Nest CLI and ts-jest.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  USER
  MANAGER
  ADMIN
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ToiletStatus {
  OPEN
  CLOSED
  UNDER_MAINTENANCE
}

enum AccessType {
  FREE
  PAID
  UNKNOWN
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ReportCategory {
  DIRTY
  NO_WATER
  NO_SOAP
  BROKEN_DOOR
  BROKEN_EQUIPMENT
  INCORRECT_LOCATION
  INCORRECT_PRICE
  CLOSED
  OTHER
}

enum Language {
  EN
  KM
}

enum NotificationType {
  SUGGESTION_SUBMITTED
  SUGGESTION_APPROVED
  SUGGESTION_REJECTED
  REPORT_CREATED
  REPORT_STATUS_CHANGED
  REVIEW_MODERATED
  ROLE_CHANGED
  MANAGER_ASSIGNED
  SYSTEM
}

// ───────────────────────────── Accounts ─────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(254) // stored lower-cased
  passwordHash      String
  fullName          String    @db.VarChar(120)
  phone             String?   @db.VarChar(32)
  avatarPath        String? // object path inside the avatars bucket
  preferredLanguage Language  @default(EN)
  role              UserRole  @default(USER)
  isActive          Boolean   @default(true)
  /// Incremented on password change, role change, deactivation or "log out everywhere".
  /// Access tokens carrying an older version are rejected.
  tokenVersion      Int       @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  suggestions         ToiletSuggestion[]    @relation("SuggestionContributor")
  reviewedSuggestions ToiletSuggestion[]    @relation("SuggestionReviewer")
  suggestionImages    SuggestionImage[]
  reviews             Review[]              @relation("ReviewAuthor")
  moderatedReviews    Review[]              @relation("ReviewModerator")
  reports             Report[]              @relation("ReportReporter")
  resolvedReports     Report[]              @relation("ReportResolver")
  reportImages        ReportImage[]
  reportStatusChanges ReportStatusHistory[]
  favorites           Favorite[]
  managerAssignments  ManagerAssignment[]   @relation("AssignmentManager")
  assignmentsCreated  ManagerAssignment[]   @relation("AssignmentCreator")
  cleaningSchedules   CleaningSchedule[]
  cleaningLogs        CleaningLog[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  toiletImages        ToiletImage[]
  toiletsCreated      Toilet[]              @relation("ToiletCreator")
  toiletsVerified     Toilet[]              @relation("ToiletVerifier")
  toiletsArchived     Toilet[]              @relation("ToiletArchiver")

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id           String    @id @db.Uuid // equals the JWT "jti"
  userId       String    @db.Uuid
  familyId     String    @db.Uuid // all rotations of one login share a family
  tokenHash    String    @unique // SHA-256 of the refresh JWT
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique // SHA-256 of the emailed token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Toilets ─────────────────────────────

model Toilet {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @db.VarChar(150)
  nameKm        String?      @db.VarChar(150)
  description   String?      @db.VarChar(2000)
  descriptionKm String?      @db.VarChar(2000)
  address       String       @db.VarChar(300)
  province      String       @default("Phnom Penh") @db.VarChar(80)
  district      String?      @db.VarChar(80) // Khan
  sangkat       String?      @db.VarChar(80)
  latitude      Float
  longitude     Float
  accessType    AccessType   @default(UNKNOWN)
  priceKhr      Int? // null = unknown; 0 for FREE
  status        ToiletStatus @default(OPEN)
  notes         String?      @db.VarChar(1000)

  // Aggregates, recalculated from visible (non-hidden) reviews inside the review transaction.
  averageRating     Float?
  cleanlinessRating Float?
  reviewCount       Int    @default(0)

  isVerified     Boolean   @default(false)
  verifiedAt     DateTime?
  lastVerifiedAt DateTime?
  verifiedById   String?   @db.Uuid

  archivedAt    DateTime?
  archivedById  String?   @db.Uuid
  archiveReason String?   @db.VarChar(500)

  coverImageId String? @unique @db.Uuid
  createdById  String? @db.Uuid
  /// True for development seed records. These are fictional and must be labelled as such.
  isSampleData Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility           Facility?
  openingHours       OpeningHour[]
  images             ToiletImage[]       @relation("ToiletImages")
  coverImage         ToiletImage?        @relation("ToiletCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  reviews            Review[]
  reports            Report[]
  favorites          Favorite[]
  managerAssignments ManagerAssignment[]
  cleaningSchedules  CleaningSchedule[]
  cleaningLogs       CleaningLog[]
  sourceSuggestion   ToiletSuggestion?   @relation("SuggestionPublishedToilet")
  createdBy          User?               @relation("ToiletCreator", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedBy         User?               @relation("ToiletVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  archivedBy         User?               @relation("ToiletArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([isVerified, archivedAt])
  @@index([latitude, longitude])
  @@index([district])
  @@index([accessType])
  @@index([status])
  @@index([averageRating])
}

/// One row per toilet. NULL = unknown.
model Facility {
  id                   String   @id @default(uuid()) @db.Uuid
  toiletId             String   @unique @db.Uuid
  hasWater             Boolean?
  hasSoap              Boolean?
  wheelchairAccessible Boolean?
  babyChanging         Boolean?
  hasToiletPaper       Boolean?
  hasHandDryer         Boolean?
  isGenderNeutral      Boolean?
  updatedAt            DateTime @updatedAt

  toilet Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)

  @@index([hasWater])
  @@index([hasSoap])
  @@index([wheelchairAccessible])
}

/// A toilet without any OpeningHour rows has an UNKNOWN schedule.
/// A toilet with rows is closed on days/times not covered by a row.
model OpeningHour {
  id          String @id @default(uuid()) @db.Uuid
  toiletId    String @db.Uuid
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday (Asia/Phnom_Penh)
  openMinute  Int // 0 … 1439
  closeMinute Int // openMinute+1 … openMinute+1440 (values > 1440 continue into the next day)

  toilet Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)

  @@index([toiletId, dayOfWeek])
  @@index([dayOfWeek, openMinute, closeMinute])
}

model ToiletImage {
  id                      String   @id @default(uuid()) @db.Uuid
  toiletId                String   @db.Uuid
  bucket                  String   @db.VarChar(63)
  objectPath              String   @db.VarChar(512)
  mimeType                String   @db.VarChar(50)
  sizeBytes               Int
  width                   Int?
  height                  Int?
  sha256                  String?  @db.Char(64)
  caption                 String?  @db.VarChar(300)
  sortOrder               Int      @default(0)
  uploadedById            String?  @db.Uuid
  /// Set when the image was published from an approved suggestion.
  sourceSuggestionImageId String?  @unique @db.Uuid
  createdAt               DateTime @default(now())

  toilet      Toilet           @relation("ToiletImages", fields: [toiletId], references: [id], onDelete: Cascade)
  coverOf     Toilet?          @relation("ToiletCover")
  uploadedBy  User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  sourceImage SuggestionImage? @relation(fields: [sourceSuggestionImageId], references: [id], onDelete: SetNull)

  @@unique([toiletId, sha256])
  @@index([toiletId, sortOrder])
  @@index([bucket, objectPath])
}

// ───────────────────────────── Suggestions ─────────────────────────────

model ToiletSuggestion {
  id            String           @id @default(uuid()) @db.Uuid
  contributorId String           @db.Uuid
  status        SuggestionStatus @default(PENDING)

  name                 String     @db.VarChar(150)
  nameKm               String?    @db.VarChar(150)
  description          String?    @db.VarChar(2000)
  address              String     @db.VarChar(300)
  province             String     @default("Phnom Penh") @db.VarChar(80)
  district             String?    @db.VarChar(80)
  sangkat              String?    @db.VarChar(80)
  latitude             Float
  longitude            Float
  accessType           AccessType @default(UNKNOWN)
  priceKhr             Int?
  hasWater             Boolean?
  hasSoap              Boolean?
  wheelchairAccessible Boolean?
  babyChanging         Boolean?
  hasToiletPaper       Boolean?
  /// Proposed opening hours: [{ dayOfWeek, opensAt, closesAt }] or null when unknown.
  openingHours         Json?
  notes                String?    @db.VarChar(1000)

  /// Potential duplicates found at submission time (admin-only).
  hasPotentialDuplicate Boolean @default(false)
  duplicateCandidates   Json?

  reviewedById      String?   @db.Uuid
  reviewedAt        DateTime?
  rejectionReason   String?   @db.VarChar(1000)
  reviewNote        String?   @db.VarChar(1000)
  /// Corrections the administrator applied when publishing (the submitted fields are kept unchanged).
  reviewCorrections Json?

  /// Unique: one suggestion publishes at most one toilet, and one toilet comes from at most one suggestion.
  publishedToiletId String? @unique @db.Uuid
  /// A corrected resubmission points to the rejected suggestion it replaces (history is preserved).
  resubmittedFromId String? @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributor     User              @relation("SuggestionContributor", fields: [contributorId], references: [id], onDelete: Cascade)
  reviewedBy      User?             @relation("SuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedToilet Toilet?           @relation("SuggestionPublishedToilet", fields: [publishedToiletId], references: [id], onDelete: Restrict)
  resubmittedFrom ToiletSuggestion? @relation("SuggestionResubmission", fields: [resubmittedFromId], references: [id], onDelete: SetNull)
  resubmission    ToiletSuggestion? @relation("SuggestionResubmission")
  images          SuggestionImage[]

  @@index([status, createdAt])
  @@index([contributorId, createdAt])
  @@index([latitude, longitude])
}

/// Private upload. suggestionId is NULL until the image is attached to a submission.
model SuggestionImage {
  id            String    @id @default(uuid()) @db.Uuid
  suggestionId  String?   @db.Uuid
  uploaderId    String    @db.Uuid
  bucket        String    @db.VarChar(63)
  objectPath    String    @db.VarChar(512)
  mimeType      String    @db.VarChar(50)
  sizeBytes     Int
  width         Int?
  height        Int?
  sha256        String    @db.Char(64)
  isCover       Boolean   @default(false)
  sortOrder     Int       @default(0)
  attachedAt    DateTime?
  removedAt     DateTime? // moderation removal
  removedReason String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())

  suggestion  ToiletSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  uploader    User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  publishedAs ToiletImage?

  @@unique([suggestionId, sha256])
  @@index([uploaderId, suggestionId])
  @@index([suggestionId, sortOrder])
  @@index([bucket, objectPath])
  @@index([createdAt])
}

// ───────────────────────────── Reviews ─────────────────────────────

model Review {
  id                String    @id @default(uuid()) @db.Uuid
  toiletId          String    @db.Uuid
  userId            String    @db.Uuid
  rating            Int // 1 … 5
  cleanlinessRating Int // 1 … 5
  comment           String?   @db.VarChar(2000)
  isHidden          Boolean   @default(false)
  hiddenReason      String?   @db.VarChar(500)
  moderatedById     String?   @db.Uuid
  moderatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  toilet      Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  user        User   @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy User?  @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([userId, toiletId])
  @@index([toiletId, isHidden, createdAt])
}

// ───────────────────────────── Reports ─────────────────────────────

model Report {
  id             String         @id @default(uuid()) @db.Uuid
  toiletId       String         @db.Uuid
  reporterId     String         @db.Uuid
  category       ReportCategory
  description    String         @db.VarChar(2000)
  status         ReportStatus   @default(PENDING)
  resolutionNote String?        @db.VarChar(1000)
  resolvedById   String?        @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  toilet        Toilet                @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  reporter      User                  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy    User?                 @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  images        ReportImage[]
  statusHistory ReportStatusHistory[]

  @@index([toiletId, status])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model ReportImage {
  id         String    @id @default(uuid()) @db.Uuid
  reportId   String?   @db.Uuid
  uploaderId String    @db.Uuid
  bucket     String    @db.VarChar(63)
  objectPath String    @db.VarChar(512)
  mimeType   String    @db.VarChar(50)
  sizeBytes  Int
  width      Int?
  height     Int?
  sha256     String    @db.Char(64)
  sortOrder  Int       @default(0)
  attachedAt DateTime?
  createdAt  DateTime  @default(now())

  report   Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@unique([reportId, sha256])
  @@index([uploaderId, reportId])
  @@index([createdAt])
}

model ReportStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  reportId    String        @db.Uuid
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  note        String?       @db.VarChar(1000)
  changedById String?       @db.Uuid
  createdAt   DateTime      @default(now())

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
}

// ───────────────────────────── Favorites ─────────────────────────────

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  toiletId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  toilet Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)

  @@unique([userId, toiletId])
  @@index([userId, createdAt])
}

// ───────────────────────────── Facility management ─────────────────────────────

model ManagerAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  managerId    String   @db.Uuid
  toiletId     String   @db.Uuid
  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  manager    User   @relation("AssignmentManager", fields: [managerId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  toilet     Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)

  @@unique([managerId, toiletId])
  @@index([toiletId])
}

model CleaningSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  toiletId    String   @db.Uuid
  dayOfWeek   Int // 0 = Sunday … 6 = Saturday
  startMinute Int // minutes from local midnight
  notes       String?  @db.VarChar(500)
  assignedTo  String?  @db.VarChar(120) // free-text cleaner / team name
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  toilet    Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([toiletId, dayOfWeek])
}

model CleaningLog {
  id            String   @id @default(uuid()) @db.Uuid
  toiletId      String   @db.Uuid
  loggedById    String?  @db.Uuid
  cleanedAt     DateTime @default(now())
  notes         String?  @db.VarChar(1000)
  waterRefilled Boolean?
  soapRefilled  Boolean?
  paperRefilled Boolean?
  createdAt     DateTime @default(now())

  toilet   Toilet @relation(fields: [toiletId], references: [id], onDelete: Cascade)
  loggedBy User?  @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@index([toiletId, cleanedAt])
}

// ───────────────────────────── Notifications & audit ─────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.VarChar(1000)
  titleKm   String?          @db.VarChar(200)
  messageKm String?          @db.VarChar(1000)
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(60)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
