{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "rootDir": "./"
  },
  "include": [
    "src/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "prisma",
    "prisma.config.ts"
  ]
}
