# ToiletGo KH backend — copy to .env and fill in. Never commit .env.
# Required values are validated at startup (src/config/env.validation.ts); the app refuses to start without them.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Set to the number of trusted reverse proxies (e.g. 1 behind Nginx / Cloudflare Tunnel) so rate limiting sees real client IPs.
TRUST_PROXY=0

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────
# Runtime queries. Supabase "Transaction pooler" (port 6543) is recommended:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Prisma CLI (migrate / seed). Direct connection or "Session pooler" (port 5432):
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ── JWT ──────────────────────────────────────────────────────────────────
# Use two different random values of at least 32 characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=toiletgo-kh
JWT_AUDIENCE=toiletgo-kh-web

# ── Refresh-token cookie ─────────────────────────────────────────────────
# lax works when frontend and API share a site (localhost:5173 ↔ localhost:3000, app.example.com ↔ api.example.com).
# Use none (requires COOKIE_SECURE=true / HTTPS) only if the frontend is on a different site.
COOKIE_SAMESITE=lax
# true in production (HTTPS). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Optional cookie domain, e.g. .example.com. Leave empty for host-only cookies.
COOKIE_DOMAIN=

# ── Supabase Storage (server-side only; never expose the service-role key to the browser) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TOILET_BUCKET=toilet-images
SUPABASE_SUGGESTION_BUCKET=suggestion-images
SUPABASE_REPORT_BUCKET=report-images
SUPABASE_AVATAR_BUCKET=avatars
# Lifetime of signed image URLs returned by the API, in seconds.
SIGNED_URL_EXPIRES_IN=3600

# ── Frontend / CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. The first one is used to build e-mail and QR links.
FRONTEND_URL=http://localhost:5173

# ── Administrator (used by `npx prisma db seed` and `npm run admin:create`) ──
# ADMIN_PASSWORD: at least 12 characters with letters and digits. Never reuse a development password in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ToiletGo Administrator

# ── Development seed only ────────────────────────────────────────────────
# Password for the fictional sample accounts (random and printed once if empty).
SEED_DEMO_PASSWORD=
# true = upload generated, clearly labelled placeholder images to Supabase Storage.
SEED_UPLOAD_IMAGES=false

# ── SMTP (password-reset e-mail). If unset, /auth/forgot-password returns 503. ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS (port 465); false uses STARTTLS when the server offers it.
SMTP_SECURE=false
SMTP_FROM="ToiletGo KH <no-reply@example.com>"

# ── Misc ─────────────────────────────────────────────────────────────────
# Swagger UI at /api/docs. Empty = enabled outside production, disabled in production.
SWAGGER_ENABLED=
PASSWORD_RESET_EXPIRES_MINUTES=30
# Default requests per minute per client IP (auth, upload and submission routes have stricter limits).
THROTTLE_LIMIT=120
