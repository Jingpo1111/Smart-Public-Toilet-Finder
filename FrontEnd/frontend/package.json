    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.2",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
