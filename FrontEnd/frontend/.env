# Public frontend settings, included in Git for Vercel builds.
VITE_APP_NAME=ToiletGo KH
# npm run dev
VITE_API_BASE_URL_LOCAL=http://localhost:3005/api
# npm run build (set the full HTTPS URL if the backend has its own domain)
VITE_API_BASE_URL_PUBLIC=https://acer-server.tail119907.ts.net:8443/api
VITE_DEFAULT_LATITUDE=11.5564
VITE_DEFAULT_LONGITUDE=104.9282
VITE_DEFAULT_MAP_ZOOM=13
# Override if the NestJS OpenAPI export has another location.
# VITE_OPENAPI_URL=/openapi.json
# The sibling NestJS backend rotates an HttpOnly refresh cookie.
VITE_COOKIE_AUTH=true
# Use the generated API contract for a matching production deployment with private Swagger.
# VITE_API_CONTRACT=bundled
