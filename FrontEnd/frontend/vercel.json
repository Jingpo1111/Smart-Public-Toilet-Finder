{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_API_BASE_URL=/api npm run build",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://acer-server.tail119907.ts.net:8443/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
